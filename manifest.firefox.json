{
  "manifest_version": 3,
  "name": "See No Numbers",
  "version": "1.0.68",
  "description": "Hide numbers on any website.",
  "browser_specific_settings": {
    "gecko": {
      "id": "see-no-numbers@wells.ee",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "commands": {
    "toggle-masking": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Toggle number masking for current site"
    },
    "toggle-global": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Toggle global enable/disable"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injection.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/emoji_on_16.png",
    "32": "icons/emoji_on_32.png",
    "48": "icons/emoji_on_48.png",
    "128": "icons/emoji_on_128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Number masking settings",
    "default_popup": "popup.html"
  }
}
